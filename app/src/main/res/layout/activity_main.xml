<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_days"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_days"
        android:inputType="number"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_transport"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgTransport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbOwn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trans_own"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbBus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trans_bus" />

        <RadioButton
            android:id="@+id/rbPlane"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trans_plane" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_options"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cbGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/opt_guide"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cbBreakfast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/opt_breakfast"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_calculate"
        android:textSize="16sp" />

</LinearLayout>